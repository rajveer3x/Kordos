POSTGRES_DB=kordos
POSTGRES_USER=kordos_migrator
POSTGRES_PASSWORD=kordos-local-migration
POSTGRES_APP_PASSWORD=kordos-local-runtime
POSTGRES_BRIEF_WORKER_PASSWORD=kordos-local-brief-worker
POSTGRES_PORT=55432
MIGRATION_DATABASE_URL=postgres://kordos_migrator:kordos-local-migration@127.0.0.1:55432/kordos
DATABASE_URL=postgres://kordos_app:kordos-local-runtime@127.0.0.1:55432/kordos
BRIEF_WORKER_DATABASE_URL=postgres://kordos_brief_worker:kordos-local-brief-worker@127.0.0.1:55432/kordos

REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

STORAGE_PORT=58333
STORAGE_ENDPOINT=http://127.0.0.1:58333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kordos-private
STORAGE_ACCESS_KEY_ID=kordos-local-storage
STORAGE_SECRET_ACCESS_KEY=kordos-local-storage-secret

API_PORT=4301
WEB_PORT=4317
ENABLE_FOUNDATION_JOBS=true

# Auth0 Regular Web Application. Uncomment all three to enable local sign-in.
# AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
# AUTH0_CLIENT_ID=YOUR_CLIENT_ID
# AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
# APP_ORIGIN=http://127.0.0.1:4317

# Optional models. Keep credentials on the server side. Brief and meeting models use the worker.
# OPENAI_API_KEY=
# OPENAI_BRIEF_MODEL=
# OPENAI_MEETING_MODEL=gpt-4o-transcribe-diarize

# Optional search models. Set the key and embedding model in the API and worker.
# OPENAI_SEARCH_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_SEARCH_ANSWER_MODEL=
# OPENAI_SEARCH_BASE_URL=https://api.openai.com/v1/

# Optional inbox email. Email delivery uses BRIEF_WORKER_DATABASE_URL above.
# INBOX_EMAIL_URL=http://127.0.0.1:4491/emails
# INBOX_EMAIL_KEY=local-sink
# INBOX_EMAIL_FROM=Kordos <kordos@example.test>

# Optional connector fixture. Use the same token key and fixture URL in the API and worker.
# CONNECTOR_TOKEN_KEY=
# CONNECTOR_FIXTURE_URL=http://127.0.0.1:4493/
# CONNECTOR_FIXTURE_WEBHOOK_SECRET=

# GitHub App. Bind each installation ID to its authorized Kordos workspace UUID.
# GITHUB_INSTALLATIONS={"12345":"00000000-0000-4000-8000-000000000001"}
# GITHUB_WEBHOOK_SECRET=
# Worker only. Use a PEM private key with escaped newlines.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Optional read-only Google OAuth. Set these values in the API and worker.
# Reuse CONNECTOR_TOKEN_KEY and BRIEF_WORKER_DATABASE_URL above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
