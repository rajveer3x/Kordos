map $http_upgrade $kordos_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    access_log off;
    error_log /dev/stderr crit;

    # Resolve the configured upstream on demand so a recreated API service is found.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $kordos_api ${KORDOS_API_UPSTREAM};

    location /api/ {
        client_max_body_size 32m;
        proxy_pass $kordos_api;
        proxy_set_header Host $host;
    }

    location /realtime/ {
        proxy_pass $kordos_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $kordos_connection;
        proxy_read_timeout 75s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
